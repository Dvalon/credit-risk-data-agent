# Kaggle credentials for `make download`. Never commit a filled-in .env.
# Create a token at https://www.kaggle.com/settings/api
#
# Prefer a current API token (it starts with KGAT_):
KAGGLE_API_TOKEN=
#
# Or a legacy API key pair (Create Legacy API Key on the same page):
KAGGLE_USERNAME=
KAGGLE_KEY=
